# CoinGlass — https://coinglass.com/pricing
COINGLASS_API_KEY=your_key_here

# Glassnode — https://glassnode.com/pricing
GLASSNODE_API_KEY=your_key_here

# Deribit — https://www.deribit.com (API keys under Account > API)
# Note: options market data is public — no auth needed for market data fetches
DERIBIT_CLIENT_ID=your_client_id_here
DERIBIT_CLIENT_SECRET=your_client_secret_here

# CoinMarketCap — https://pro.coinmarketcap.com/signup
CMC_API_KEY=your_key_here

# FRED (Federal Reserve Economic Data) — https://fred.stlouisfed.org/docs/api/api_key.html
# Free API key — needed for 10Y real yield data
FRED_API_KEY=your_key_here

# yfinance (SPX, DXY, Gold) — free, no key needed
